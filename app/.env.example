# ===== auto_write 환경변수 예시 파일 (.env.example) =====
# 사용법:
#   1) 이 파일을 복사해서 app\.env 로 만드세요.
#        PowerShell:  copy app\.env.example app\.env
#   2) app\.env 파일을 열어 아래 값에 "실제 키"를 채우세요.
#   3) app\.env 는 .gitignore 에 의해 깃(GitHub)에 절대 올라가지 않습니다.
#
# ※ 이 예시 파일(.env.example)에는 절대 실제 키를 넣지 마세요. (빈칸/설명만)

# --- AI API 키 (둘 중 최소 하나는 필요) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- (선택) 사용할 모델 : 비워두면 코드의 기본값 사용 ---
# AUTO_WRITE_OPENAI_MODEL=gpt-4.1-mini
# AUTO_WRITE_OPENAI_SEARCH_MODEL=gpt-4.1-mini
# AUTO_WRITE_OPENAI_IMAGE_MODEL=gpt-image-1
# AUTO_WRITE_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# AUTO_WRITE_ANTHROPIC_SEARCH_MODEL=claude-sonnet-4-20250514
# AUTO_WRITE_ANTHROPIC_WRITING_MODEL=

# --- (선택) 로컬 서버 호스트/포트 ---
# AUTO_WRITE_HOST=127.0.0.1
# AUTO_WRITE_PORT=8765

# --- (선택) 작업 폴더 / 참고자료 폴더 경로 ---
# AUTO_WRITE_WORKSPACE_ROOT=
# AUTO_WRITE_REFERENCE_LIBRARY_DIR=
# AUTO_WRITE_TEMPLATE_AI_REFINE=
